# Copiar a .env y completar con valores reales.
# Nunca commitear .env con secretos reales — ver .gitignore.

# --- docker-compose.yml (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=helpdesk
POSTGRES_PORT=5432

# --- Prisma / NestJS (api/prisma.config.ts) ---
# Debe mantenerse coherente con las variables de arriba: postgresql://USER:PASSWORD@localhost:PORT/DB
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/helpdesk?schema=public"

# --- Más variables se agregan aquí conforme se implementan: ---
# JWT_SECRET, JWT_REFRESH_SECRET (autenticación)
# CORS_ORIGIN (restricción de origen del frontend)
# REDIS_URL (si se elige el reto de especialidad de notificaciones async)
