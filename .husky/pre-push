#!/usr/bin/env sh
API_CHANGED=0
WEB_CHANGED=0
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base=$(git rev-list --max-parents=0 "$local_sha")
  else
    base=$remote_sha
  fi
  changed=$(git diff --name-only "$base" "$local_sha")
  if echo "$changed" | grep -q "^api/"; then
    API_CHANGED=1
  fi
  if echo "$changed" | grep -q "^web/"; then
    WEB_CHANGED=1
  fi
done

if [ "$API_CHANGED" = "1" ]; then
  echo "Cambios detectados en api/ — ejecutando tests E2E del backend"
  (cd api && npm run test:e2e) || exit 1
else
  echo "Sin cambios en api/ — se omiten tests E2E del backend"
fi

if [ "$WEB_CHANGED" = "1" ]; then
  echo "Cambios detectados en web/ — ejecutando tests E2E del frontend"
  (cd web && npm run test:e2e) || exit 1
else
  echo "Sin cambios en web/ — se omiten tests E2E del frontend"
fi

exit 0
