{
  "name": "web",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,vue,js,json}\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "@pinia/nuxt": "1.0.3",
    "nuxt": "3.21.11",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "h3": "1.15.11"
  }
}
